@InProceedings{tran11cvpr,
  Title                    = {Optimal spatio-temporal path discovery for video event detection},
  Author                   = {D. Tran and J. Yuan},
  Booktitle                = cvpr,
  Year                     = {2011},

  File                     = {tran11cvpr.pdf:tran11cvpr.pdf:PDF},
  Review                   = {Consider windows W(v) of a fixed scale and aspect ratio, centered at v=(x,y,t).
Construct trellis that conects windows in neighboring frames that are at most one position shift in x,y, ie 9 connected between W(v) and the next frame.
Score of a path is sum of window scores, find maximum via dynamic programming. 
Requires scores to be both positive and negative in order to potentially obtain paths that do not cover the full temporal extent.
Can be extended to multiple scales by extending the trellis over scale, resulting in 27 neighbors, 9 on the same scale, and another 9 for the scale above and below.
Complexity is O(whnm), for with, height, n=duration, m=nr scales.
Assumes additive scores over a region.}
}

